<Project Sdk="Microsoft.NET.Sdk">
  <!-- Linux build project, separate from original MSBuild/Visual Studio configuration. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <!-- Loose DLLs in the checkout (including SDK/game copies) must not
         override the net472 reference assemblies or explicit game HintPaths. -->
    <AssemblySearchPaths>{HintPathFromItem};{TargetFrameworkDirectory};{RawFileName}</AssemblySearchPaths>
    <AssemblyName>BetterCollectionManager</AssemblyName>
    <RootNamespace>BetterCollectionManager</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../../artifacts/melonloader/</OutputPath>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GameInstallRoot Condition="'$(GameInstallRoot)' == ''">$(GAME_DIR)</GameInstallRoot>
    <GameManagedDir>$(GameInstallRoot)/Hearthstone_Data/Managed</GameManagedDir>
    <MelonDllDir Condition="'$(MelonDllDir)' == ''">$(GameInstallRoot)/MelonLoader/net35</MelonDllDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <Import Project="BetterCollectionManager.Shared.props" />
  <ItemGroup>
    <Compile Include="BetterCollectionManagerMod.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="MelonLoader"><HintPath>$(MelonDllDir)/MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(MelonDllDir)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManagedDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Blizzard.T5.Game"><HintPath>$(GameManagedDir)/Blizzard.T5.Game.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Blizzard.T5.Core"><HintPath>$(GameManagedDir)/Blizzard.T5.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Blizzard.T5.AssetManager"><HintPath>$(GameManagedDir)/Blizzard.T5.AssetManager.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Blizzard.T5.AssetLoader"><HintPath>$(GameManagedDir)/Blizzard.T5.AssetLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Blizzard.T5.ServiceLocator"><HintPath>$(GameManagedDir)/Blizzard.T5.ServiceLocator.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Blizzard.T5.UberText.Runtime"><HintPath>$(GameManagedDir)/Blizzard.T5.UberText.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="blizzard.bgsclient"><HintPath>$(GameManagedDir)/blizzard.bgsclient.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(GameManagedDir)/UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameManagedDir)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(GameManagedDir)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManagedDir)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(GameManagedDir)/UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(GameManagedDir)/UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(GameManagedDir)/UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(GameManagedDir)/UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>

    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(GameManagedDir)/UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../data/Packages.json"><LogicalName>BetterCollectionManager.Packages.json</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="../../data/Categories.json">
      <LogicalName>BetterCollectionManager.Categories.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <Target Name="ValidateGameInstall" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GameInstallRoot)' == ''" Text="Set GAME_DIR or GameInstallRoot to your Hearthstone installation." />
    <Error Condition="!Exists('$(MelonDllDir)/MelonLoader.dll') Or !Exists('$(MelonDllDir)/0Harmony.dll')" Text="Set MelonDllDir to the directory containing MelonLoader.dll and 0Harmony.dll." />
  </Target>
</Project>
